# ==============================================================================
# Enterprise Warehouse & Inventory Management System (WMS) Environment Variables
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=production

# Database Configuration (PostgreSQL 17)
POSTGRES_DB=stockmanager
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=StockSecret2025
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://stockuser:StockSecret2025@postgres:5432/stockmanager

# Redis Cache & Sessions (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Security & JWT Token Configuration
# Generate a strong 32-byte secret: openssl rand -hex 32
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Super Admin Seed Credentials
SUPERUSER_EMAIL=admin@stockmanager.local
SUPERUSER_PASSWORD=Admin@123456
SUPERUSER_FULL_NAME="Super Administrator"

# Frontend Configuration
VITE_API_URL=/api/v1
